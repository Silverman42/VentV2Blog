---
import { SITE } from '../../data/site';
import type { BlogCategory } from '../../lib/blogApi/types';
import Icon from '../Shared/Icon.astro';

interface Props {
  /** 'all' for home, category slug for a category page, otherwise undefined. */
  current?: string;
  /** Top-level categories from the blog API. */
  categories: BlogCategory[];
}

const { current, categories } = Astro.props;
const items = [{ slug: 'all', name: 'All stories' }, ...categories.map(({ slug, name }) => ({ slug, name }))];
---

<div data-drawer data-open="false" class="group/drawer">
  <div
    data-drawer-close
    class="pointer-events-none fixed inset-0 z-70 bg-abyss/40 opacity-0 transition-opacity duration-300 ease-out group-data-[open=true]/drawer:pointer-events-auto group-data-[open=true]/drawer:opacity-100"
  >
  </div>
  <aside
    id="category-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Categories"
    aria-hidden="true"
    inert
    class="glass-strong invisible fixed top-3 right-3 bottom-3 z-71 flex w-[min(380px,calc(100vw-24px))] translate-x-[calc(100%+24px)] flex-col gap-6 overflow-y-auto rounded-3xl p-5 transition-[transform,visibility] duration-300 ease-out-expo group-data-[open=true]/drawer:visible group-data-[open=true]/drawer:translate-x-0"
  >
    <div class="flex items-center justify-between">
      <span class="pl-2 text-[13px] leading-none font-bold tracking-[0.08em] text-ink-600">CATEGORIES</span>
      <button
        type="button"
        data-drawer-close
        aria-label="Close menu"
        class="grid size-11 place-items-center rounded-full border border-line-200 bg-surface text-ink-900 hover:border-brand-700"
      >
        <Icon name="close" size={18} />
      </button>
    </div>
    <nav aria-label="Categories" class="flex flex-col gap-1">
      {
        items.map((c, i) => {
          const on = c.slug === current;
          return (
            <a
              href={c.slug === 'all' ? '/' : `/category/${c.slug}`}
              aria-current={on ? 'page' : undefined}
              style={`--d:${120 + i * 50}ms`}
              class:list={[
                'flex min-h-14 translate-x-10 items-center gap-3 py-3 pl-2 no-underline opacity-0 transition-[opacity,transform,color] duration-[380ms,380ms,150ms] ease-out-expo hover:text-brand-500! group-data-[open=true]/drawer:translate-x-0 group-data-[open=true]/drawer:opacity-100 group-data-[open=true]/drawer:delay-(--d)',
                on ? 'text-brand-700!' : 'text-ink-900!',
              ]}
            >
              <span class="min-w-0 flex-1 text-lg leading-[1.2] font-semibold">{c.name}</span>
              <Icon name="chevron-right" size={20} />
            </a>
          );
        })
      }
    </nav>
    <a
      href={SITE.downloadUrl}
      target="_blank"
      rel="noopener"
      class="mt-auto flex h-[52px] items-center justify-center gap-2 rounded-full bg-brand-500 px-6 text-base leading-none font-semibold text-white! no-underline transition-colors duration-150 hover:bg-brand-600 sm:hidden"
    >
      <Icon name="download" size={18} />
      Download the Vent app
    </a>
  </aside>
</div>

<script>
  import '../../scripts/drawer';
</script>
