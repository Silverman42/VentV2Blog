---
/**
 * Saved posts are built in the browser by scripts/saved.ts from the encrypted bookmark store,
 * using the same card templates as the API listings. Each card links to /posts/{slug}.
 */
import CardTemplates from '../Shared/CardTemplates.astro';
import SavedEmpty from './SavedEmpty.astro';
---

<div data-saved-list>
  <ul
    data-saved-grid
    data-reveal
    hidden
    class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 md:gap-6 lg:gap-8"
  >
  </ul>
  <SavedEmpty />
  <CardTemplates />
</div>

<script>
  import '../../scripts/saved';
</script>
