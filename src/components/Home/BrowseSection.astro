---
/**
 * "Browse by category": the API feed with top-level category tabs that swap it in place
 * (scripts/listing.ts). With "All" selected, carousel posts are excluded (PRD FR-3.4).
 */
import type { BlogCategory } from '../../lib/blogApi/types';
import type { CardPost, CategoryRef } from '../../lib/blogApi/view';
import CategoryTabs from '../Shared/CategoryTabs.astro';
import PostListing from '../Shared/PostListing.astro';

interface Props {
  posts: CardPost[];
  nextPage: number | null;
  perPage: number;
  categories: BlogCategory[];
  cats: CategoryRef[];
  carouselIds: string[];
  error?: string;
}

const { posts, nextPage, perPage, categories, cats, carouselIds, error } = Astro.props;
const tabs = [{ slug: 'all', name: 'All' }, ...categories.map(({ id, slug, name }) => ({ id, slug, name }))];
---

<section aria-labelledby="browse-heading" class="mx-auto max-w-[1500px] px-4 pt-[88px] pb-24 md:px-8 lg:px-12">
  <h2 id="browse-heading" class="m-0 mb-6 font-display text-[26px] leading-[1.2] font-normal md:text-[30px] lg:text-4xl">
    Browse by category
  </h2>
  <PostListing mode="home" posts={posts} nextPage={nextPage} perPage={perPage} cats={cats} exclude={carouselIds} error={error}>
    <CategoryTabs slot="tabs" mode="filter" tabs={tabs} label="Filter by category" />
  </PostListing>
</section>
