---
type IconName =
  | 'search'
  | 'bookmark'
  | 'download'
  | 'menu'
  | 'close'
  | 'chevron-left'
  | 'chevron-right'
  | 'arrow-right'
  | 'link'
  | 'pause'
  | 'play'
  | 'stop'
  | 'headphones'
  | 'sun'
  | 'moon'
  | 'monitor';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  filled?: boolean;
}

const { name, size = 20, class: className, filled = false } = Astro.props;

const ICONS: Record<IconName, { body: string; stroke?: number; fill?: boolean; join?: boolean }> = {
  search: { body: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>', stroke: 1.85 },
  bookmark: { body: '<path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4.5L5 21V4a1 1 0 0 1 1-1z"/>', stroke: 1.75, join: true },
  download: { body: '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"/>', stroke: 2, join: true },
  menu: { body: '<path d="M4 7h16M4 12h16M4 17h16"/>', stroke: 1.75 },
  close: { body: '<path d="M6 6l12 12M18 6L6 18"/>', stroke: 2 },
  'chevron-left': { body: '<path d="M15 6l-6 6 6 6"/>', stroke: 2, join: true },
  'chevron-right': { body: '<path d="M9 6l6 6-6 6"/>', stroke: 2, join: true },
  'arrow-right': { body: '<path d="M5 12h14M13 6l6 6-6 6"/>', stroke: 2, join: true },
  link: {
    body: '<path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/>',
    stroke: 1.75,
    join: true,
  },
  pause: { body: '<rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>', fill: true },
  play: { body: '<path d="M7 4.5v15a1 1 0 0 0 1.5.86l12-7.5a1 1 0 0 0 0-1.72l-12-7.5A1 1 0 0 0 7 4.5z"/>', fill: true },
  stop: { body: '<rect x="6" y="6" width="12" height="12" rx="1.5"/>', fill: true },
  headphones: {
    body: '<path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4.5" height="7" rx="1.5"/><rect x="16.5" y="14" width="4.5" height="7" rx="1.5"/>',
    stroke: 1.75,
    join: true,
  },
  sun: {
    body: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/>',
    stroke: 1.75,
  },
  moon: { body: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>', stroke: 1.75, join: true },
  monitor: { body: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>', stroke: 1.75, join: true },
};

const icon = ICONS[name];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={icon.fill || filled ? 'currentColor' : 'none'}
  stroke={icon.fill ? 'none' : 'currentColor'}
  stroke-width={icon.stroke}
  stroke-linecap="round"
  stroke-linejoin={icon.join ? 'round' : undefined}
  class:list={['flex-none', className]}
  aria-hidden="true"
  focusable="false"
  set:html={icon.body}
/>
