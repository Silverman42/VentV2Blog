---
import type { PostPage } from '../../lib/blogApi/article';
import ShareButtons from './ShareButtons.astro';

interface Props {
  post: PostPage;
}

const { post } = Astro.props;
const initials = (post.author ?? '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join('');
---

<div class="flex flex-wrap items-center gap-x-8 gap-y-5 border-b border-line-200 py-5">
  {post.author && (
  <div class="flex items-center gap-3">
    <div
      class="grid size-11 flex-none place-items-center rounded-full bg-brand-100 text-sm font-bold text-brand-700"
      aria-hidden="true"
    >
      {initials}
    </div>
    <div class="flex flex-col gap-1">
      <span class="text-[13px] leading-none font-medium text-ink-600">Written by</span>
      <span class="text-[15px] leading-none font-semibold">{post.author}</span>
    </div>
  </div>
  )}
  <div class="flex flex-col gap-1">
    <span class="text-[13px] leading-none font-medium text-ink-600">Published</span>
    <time datetime={post.iso} class="text-[15px] leading-none font-semibold">{post.date}</time>
  </div>
  {post.readTime && (
    <div class="flex flex-col gap-1">
      <span class="text-[13px] leading-none font-medium text-ink-600">Reading time</span>
      <span class="text-[15px] leading-none font-semibold">{post.readTime}</span>
    </div>
  )}
  <div class="md:ml-auto">
    <ShareButtons post={post} />
  </div>
</div>
