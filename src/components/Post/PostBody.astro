---
import type { PostSummary } from '../../lib/posts';
import ShareButtons from './ShareButtons.astro';

interface Props {
  post: PostSummary;
}

const { post } = Astro.props;
---

<div class="max-w-[70ch] text-base leading-[1.6] text-ink-900 md:text-lg">
  <div class="prose-vent">
    <slot />
  </div>
  <div class="mt-12 flex flex-wrap items-center gap-4 border-t border-line-200 pt-6">
    <span class="min-w-40 flex-1 text-[15px] leading-[1.3] font-semibold text-ink-600">Found this useful? Save or share it.</span>
    <ShareButtons post={post} />
  </div>
</div>
