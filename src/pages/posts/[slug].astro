---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostHeader from '../../components/Post/PostHeader.astro';
import PostMeta from '../../components/Post/PostMeta.astro';
import TableOfContents from '../../components/Post/TableOfContents.astro';
import PostBody from '../../components/Post/PostBody.astro';
import RelatedPosts from '../../components/Post/RelatedPosts.astro';
import { absoluteUrl, getAllEntries, getRelated, toSummary, type PostEntry } from '../../lib/posts';

export async function getStaticPaths() {
  const entries = await getAllEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: PostEntry;
}

const { entry } = Astro.props;
const post = toSummary(entry);
const { Content, headings } = await render(entry);
const related = await getRelated(post);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.iso,
  author: { '@type': 'Person', name: post.author },
  articleSection: post.category,
  mainEntityOfPage: absoluteUrl(post.url),
  publisher: { '@type': 'Organization', name: 'Vent Africa' },
};
---

<BaseLayout title={post.title} description={post.excerpt} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-[1500px] px-4 pt-10 md:px-8 lg:px-12">
    <PostHeader post={post} />
    <PostMeta post={post} />
    <div class="grid grid-cols-1 gap-16 pt-12 pb-20 lg:grid-cols-[220px_minmax(0,1fr)]">
      <TableOfContents headings={headings} />
      <PostBody post={post}>
        <Content />
      </PostBody>
    </div>
  </article>
  <RelatedPosts posts={related} category={post.category} />
</BaseLayout>
