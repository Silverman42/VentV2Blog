---
import type { PostSummary } from '../../lib/posts';
import Breadcrumb from '../Shared/Breadcrumb.astro';
import CoverImage from '../Shared/CoverImage.astro';

interface Props {
  post: PostSummary;
}

const { post } = Astro.props;
---

<Breadcrumb
  class="mb-7"
  items={[{ label: 'Home', href: '/' }, { label: post.category, href: `/category/${post.cat}` }, { label: post.title }]}
/>
<div class="flex max-w-[860px] flex-col gap-4">
  <div class="flex">
    <a
      href={`/category/${post.cat}`}
      class="inline-flex h-[30px] items-center rounded-full border border-line-200 bg-brand-100 px-3.5 text-[13px] leading-none font-semibold text-ink-900! no-underline hover:border-brand-700"
    >
      {post.category}
    </a>
  </div>
  <h1 class="m-0 font-display text-[32px] leading-[1.15] font-normal text-balance md:text-[40px] lg:text-5xl">
    {post.title}
  </h1>
  <p class="m-0 text-[19px] leading-[1.6] text-pretty text-ink-600">{post.excerpt}</p>
</div>
<div class="relative mt-8 aspect-video overflow-hidden rounded-[20px] bg-surface-alt lg:aspect-[21/9]">
  <CoverImage src={post.coverImage} alt={post.coverAlt} cat={post.cat} eager />
</div>
