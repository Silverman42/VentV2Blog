---
import Breadcrumb from '../Shared/Breadcrumb.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  name: string;
  desc: string;
  crumbs: Crumb[];
}

const { name, desc, crumbs } = Astro.props;
---

<Breadcrumb class="mb-5" items={crumbs} />
<h1 class="m-0 mb-3 font-display text-[32px] leading-[1.15] font-normal md:text-[40px] lg:text-5xl">{name}</h1>
<p class="m-0 mb-9 max-w-[620px] text-[17px] leading-[1.6] text-ink-600">{desc}</p>
