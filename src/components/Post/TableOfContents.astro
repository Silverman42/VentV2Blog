---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 0 && (
    <aside data-toc class="sticky top-[104px] hidden flex-col gap-3 self-start lg:flex">
      <span class="text-[13px] leading-none font-bold tracking-[0.08em] text-ink-600">ON THIS PAGE</span>
      <nav aria-label="Table of contents" class="flex flex-col gap-0.5 border-l border-line-200">
        {items.map((h, i) => (
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            data-active={i === 0 ? 'true' : 'false'}
            class="-ml-px border-l-2 border-transparent py-2.5 pl-4 text-[15px] leading-[1.35] font-medium text-ink-600! no-underline hover:text-brand-700! data-[active=true]:border-brand-500 data-[active=true]:font-semibold data-[active=true]:text-ink-900!"
          >
            {h.text}
          </a>
        ))}
      </nav>
    </aside>
  )
}

<script>
  import '../../scripts/toc';
</script>
