---
import type { PostSummary } from '../../lib/posts';
import BookmarkButton from './BookmarkButton.astro';
import CoverImage from './CoverImage.astro';

interface Props {
  post: PostSummary;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-[20px] border border-line-200 bg-surface transition-colors duration-200 ease-out hover:border-brand-500 hover:bg-card-hover has-[a[data-card-link]:focus-visible]:border-brand-700"
>
  <div class="flex flex-1 flex-col gap-3.5 px-6 pt-6 pb-[22px]">
    <div class="flex items-center gap-3">
      <a
        href={`/category/${post.cat}`}
        class="relative z-10 inline-flex h-[30px] flex-none items-center rounded-full border border-line-200 bg-brand-100 px-3.5 text-[13px] leading-none font-semibold text-ink-900! hover:border-brand-700"
      >
        {post.category}
      </a>
      <div class="flex min-w-0 flex-1 items-center gap-2 overflow-hidden text-sm leading-[1.4] font-medium text-ellipsis whitespace-nowrap text-ink-600">
        <time datetime={post.iso}>{post.date}</time><span aria-hidden="true">·</span><span>{post.author}</span>
      </div>
      <BookmarkButton post={post} variant="card" />
    </div>
    <Heading class="m-0 line-clamp-3 font-display text-xl leading-[1.25] font-normal text-pretty text-ink-900 md:text-2xl">
      <a
        href={post.url}
        data-card-link
        class="text-ink-900! no-underline outline-none after:absolute after:inset-0 after:content-['']"
      >
        {post.title}
      </a>
    </Heading>
    <p class="m-0 line-clamp-2 text-[15px] leading-[1.55] text-ink-600">{post.excerpt}</p>
  </div>
  <div class="relative aspect-video overflow-hidden border-t border-line-200 bg-surface-alt">
    <CoverImage
      src={post.coverImage}
      alt={post.coverAlt}
      cat={post.cat}
      class="transition-transform duration-500 ease-out-expo group-hover:scale-105 group-has-[a[data-card-link]:focus-visible]:scale-105"
    />
  </div>
</article>
