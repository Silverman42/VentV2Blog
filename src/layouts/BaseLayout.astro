---
import '../styles/global.css';
import { SITE } from '../data/site';
import Header from '../components/Layout/Header.astro';
import Footer from '../components/Layout/Footer.astro';
import SearchDialog from '../components/Layout/SearchDialog.astro';
import CategoryDrawer from '../components/Layout/CategoryDrawer.astro';
import Toast from '../components/Layout/Toast.astro';

interface Props {
  title?: string;
  description?: string;
  /** Active category for the drawer: 'all' on home, a slug on category pages. */
  currentCategory?: string;
  savedActive?: boolean;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  currentCategory,
  savedActive = false,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — Stories, guides and news on crypto in Africa`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FFFFFF" />
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('vent:theme');
        } catch (e) {}
        var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap"
    />
    <link rel="preload" href="/TheLoveClub.otf" as="font" type="font/otf" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-100 rounded-full bg-brand-500 px-5 py-3 font-semibold text-white! focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to content</a
    >
    <div class="flex min-h-screen flex-col">
      <Header savedActive={savedActive} />
      <SearchDialog />
      <CategoryDrawer current={currentCategory} />
      <main id="main" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    <Toast />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
