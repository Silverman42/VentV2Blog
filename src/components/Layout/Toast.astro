---
/**
 * Liquid-glass toast (PRD FR-4.2). Driven by scripts/ui.ts via showToast(). Slides up from below
 * the viewport when `data-open="true"` and back down when it's removed (scripts/toast.ts).
 */
---

<div
  data-toast
  role="status"
  aria-live="polite"
  hidden
  class="glass-dark fixed bottom-6 left-1/2 z-60 flex max-w-[calc(100vw-24px)] -translate-x-1/2 translate-y-[calc(100%+24px)] items-center gap-4 rounded-full py-2 pr-2 pl-5 text-[15px] leading-none font-semibold opacity-0 transition-[translate,opacity] duration-[350ms] ease-[var(--ease-out-expo)] data-[open=true]:translate-y-0 data-[open=true]:opacity-100"
>
  <span data-toast-msg class="py-2.5"></span>
  <button
    type="button"
    data-toast-undo
    hidden
    class="h-9 rounded-full border border-white/30 bg-white/14 px-4 text-sm leading-none font-semibold text-white hover:bg-white/26"
  >
    Undo
  </button>
  <span data-toast-spacer class="w-3" aria-hidden="true"></span>
</div>
