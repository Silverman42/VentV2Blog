---
import type { PostSummary } from '../../lib/posts';
import Icon from '../Shared/Icon.astro';

interface Props {
  post: PostSummary;
}

const { post } = Astro.props;
---

<!-- Hidden until the script confirms the browser supports speech synthesis. -->
<div
  data-listen
  data-listen-title={post.title}
  data-state="idle"
  hidden
  class="group mb-10 flex items-center gap-4 rounded-2xl border border-line-200 bg-surface-alt p-3 pr-4"
>
  <button
    type="button"
    data-listen-toggle
    aria-label="Listen to this article"
    aria-pressed="false"
    class="grid size-12 flex-none cursor-pointer place-items-center rounded-full bg-brand-500 text-abyss transition-colors duration-150 hover:bg-brand-600"
  >
    <span class="group-data-[state=playing]:hidden"><Icon name="play" size={18} class="translate-x-px" /></span>
    <span class="hidden group-data-[state=playing]:block"><Icon name="pause" size={18} /></span>
  </button>

  <div class="flex min-w-0 flex-1 flex-col gap-2">
    <div class="flex items-center gap-2 text-[15px] leading-none font-semibold whitespace-nowrap">
      <Icon name="headphones" size={16} class="hidden text-ink-600 sm:block" />
      <span data-listen-status aria-live="polite" class="truncate">Listen to this article</span>
      <span class="hidden text-[13px] font-medium text-ink-600 sm:inline group-data-[state=paused]:hidden group-data-[state=playing]:hidden">· {post.readTime}</span>
    </div>
    <div
      data-listen-progress
      role="progressbar"
      aria-label="Reading progress"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      class="h-1 overflow-hidden rounded-full bg-line-200"
    >
      <div data-listen-bar class="h-full w-0 rounded-full bg-brand-500 transition-[width] duration-300"></div>
    </div>
  </div>

  <button
    type="button"
    data-listen-rate
    aria-label="Reading speed 1×. Change speed"
    title="Change speed"
    class="h-9 min-w-14 flex-none cursor-pointer rounded-full border border-line-200 bg-surface px-3 text-sm leading-none font-semibold text-ink-900 tabular-nums hover:border-brand-700"
  >
    1×
  </button>
  <button
    type="button"
    data-listen-stop
    aria-label="Stop reading"
    title="Stop"
    hidden
    class="grid size-9 flex-none cursor-pointer place-items-center rounded-full border border-line-200 bg-surface text-ink-900 hover:border-brand-700"
  >
    <Icon name="stop" size={14} />
  </button>
</div>

<script>
  import '../../scripts/listen';
</script>
