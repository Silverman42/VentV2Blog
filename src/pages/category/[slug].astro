---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryHeader from '../../components/Category/CategoryHeader.astro';
import CategoryListing from '../../components/Category/CategoryListing.astro';
import CategoryTabs from '../../components/Shared/CategoryTabs.astro';
import { CATEGORIES, type Category } from '../../data/site';
import { getPostsByCategory } from '../../lib/posts';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const posts = await getPostsByCategory(category.slug);
---

<BaseLayout title={category.name} description={category.desc} currentCategory={category.slug}>
  <section class="mx-auto max-w-[1500px] px-4 pt-12 pb-24 md:px-8 lg:px-12">
    <CategoryHeader category={category} />
    <CategoryTabs mode="nav" current={category.slug} />
    <CategoryListing posts={posts} />
  </section>
</BaseLayout>
