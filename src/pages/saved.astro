---
import BaseLayout from '../layouts/BaseLayout.astro';
import SavedHeader from '../components/Saved/SavedHeader.astro';
import SavedList from '../components/Saved/SavedList.astro';
import { getAllPosts } from '../lib/posts';

const posts = await getAllPosts();
---

<BaseLayout title="Saved posts" description="Posts you've saved on this device." savedActive noindex>
  <section class="mx-auto max-w-[1500px] px-4 pt-14 pb-24 md:px-8 lg:px-12">
    <SavedHeader />
    <SavedList posts={posts} />
  </section>
</BaseLayout>
